# ProductFilter environment template.
#
# Copy to .env and fill in. Every variable the app reads is listed here — that
# is enforced by deploycheck.py, which fails if a variable is used but not
# documented, or documented but no longer used. Values shown after "#" are the
# defaults that apply when the variable is unset.
#
# Leave a line blank rather than committing a value. .env is gitignored.

# =============================================================================
# Required
# =============================================================================
SERPAPI_KEY=
SERPAPI_NUM=                    # 60 — rows requested per SerpApi call
SERPAPI_TIMEOUT=                # 30 — hang-guard on one upstream call, seconds. MUST stay
                                #   above SerpApi's real cold latency (3.6-11.5 s measured)
                                #   and below gunicorn's 45 s worker timeout

# =============================================================================
# AI tie-breaking (optional; both providers fail over to each other)
# =============================================================================
GEMINI_API_KEY=
GROQ_API_KEY=
AI_ENABLED=                     # 1
AI_MODEL_GEMINI=                # gemini-1.5-flash
AI_MODEL_GROQ=                  # llama-3.1-8b-instant
AI_TIMEOUT=                     # 6 — seconds
AI_DAILY_BUDGET=                # daily cap on AI calls
AI_TIEBREAK_LOW=                # lower trust bound that triggers a tie-break
AI_TIEBREAK_HIGH=               # upper trust bound that triggers a tie-break
AI_CACHE_PATH=                  # .ai_cache.json — set to /tmp/... on read-only hosts

# =============================================================================
# Error reporting
# =============================================================================
SENTRY_DSN=

# =============================================================================
# Performance (added for the 2026-08-13 speed-test fixes; see DEPLOY.md §6)
# =============================================================================
PREWARM=                        # 1 — keep category feeds warm in the background
PREWARM_INTERVAL=               # 900 — seconds between pre-warm cycles
STALE_TTL=                      # 86400 — how long an expired feed may still be served
MAX_REFRESH_THREADS=            # 2 — concurrent background refreshes per worker
MAX_CACHE_ENTRIES=              # 500 — price-cache ceiling
MAX_MERCHANT_ROUTES=            # merchant /go route-table ceiling
MERCHANT_TTL=                   # 21600 — resolved merchant URL lifetime, seconds
MERCHANT_TIMEOUT=               # 6 — seconds for the merchant resolution call
STATIC_MAX_AGE=                 # 31536000 — lifetime of a content-hashed /static URL
STATIC_UNVERSIONED_MAX_AGE=     # 3600 — lifetime of an unhashed /static URL
HTML_SMAX_AGE=                  # 120 — shared-cache lifetime for HTML
HTML_STALE_WHILE_REVALIDATE=    # 600 — shared-cache stale window for HTML

# =============================================================================
# Network / proxy
# =============================================================================
TRUST_PROXY_HEADERS=            # 0 — set to 1 when behind Cloudflare or a load balancer
TRUSTED_PROXY_CIDRS=            # CIDRs allowed to set X-Forwarded-For
ENABLE_HSTS=                    # 1 — required on a .dev domain
MAX_TRACKED_IPS=                # 10000 — rate-limit table ceiling

# =============================================================================
# TrustScan
# =============================================================================
TRUSTSCAN_ENABLED=              # 1
TRUSTSCAN_MIN_SCORE=            # minimum score a store must reach to be shown
TRUSTSCAN_REQUIRE_SCORE=        # require a score before showing a listing
TRUSTSCAN_UNKNOWN_CAP=          # score ceiling for stores we cannot identify
TRUSTSCAN_UNRESOLVED_SCORE=     # score used when resolution fails
TRUSTSCAN_CACHE_TTL=            # per-domain verdict cache lifetime, seconds
TRUSTSCAN_FEEDS=                # 1 — consult external reputation feeds
TRUSTSCAN_ALLOW_HTTP=           # 0 — permit plain-http merchant links
TRUSTSCAN_DEEP=                 # 0 — RDAP + DNS lookups (costs ~1s per new domain)
TRUSTSCAN_PUBLIC_DEEP=          # 0 — do NOT enable: lets anonymous callers trigger RDAP
GOOGLE_SAFE_BROWSING_KEY=
PRICE_SANITY_RATIO=             # implausible-price rejection ratio
