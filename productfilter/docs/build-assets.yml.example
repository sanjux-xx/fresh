name: Build binary assets

# The fonts and icons are generated artefacts, not hand-authored files, so this
# workflow builds them from the committed source scripts and commits the result.
#
# Why it exists: the subset woff2 fonts and WebP icons introduced by the
# 2026-08-13 speed-test fixes are binary, and were the one part of that change
# that could not be pushed through the API that landed the rest. Rather than
# leaving them as a manual step, they are rebuilt here from:
#
#   productfilter/build_fonts.py     -> static/fonts/*.woff2   (~56 KB total)
#   productfilter/generate_icons.py  -> static/icons/*.{webp,png}
#
# Both scripts are deterministic, so re-running this is always safe.

on:
  # Rebuild whenever the generators or the source artwork change. Note the
  # outputs (static/fonts, static/icons) are deliberately NOT in this list:
  # committing them must not retrigger the workflow.
  push:
    branches: [main]
    paths:
      - "productfilter/build_fonts.py"
      - "productfilter/generate_icons.py"
      - "productfilter/static/images/logo.png"
      - ".github/workflows/build-assets.yml"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: build-assets
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install build dependencies
        run: pip install --quiet fonttools brotli pillow

      - name: Subset and self-host the webfonts
        working-directory: productfilter
        run: python3 build_fonts.py

      - name: Re-encode the PWA icons
        working-directory: productfilter
        run: python3 generate_icons.py

      - name: Show what was produced
        working-directory: productfilter
        run: |
          echo "--- fonts ---"
          ls -l static/fonts
          echo "--- icons ---"
          ls -l static/icons

      - name: Commit the generated assets
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add productfilter/static/fonts productfilter/static/icons
          if git diff --cached --quiet; then
            echo "Assets already up to date — nothing to commit."
            exit 0
          fi
          git commit -m "assets: build subset fonts and re-encoded icons

          Generated by .github/workflows/build-assets.yml from build_fonts.py
          and generate_icons.py. Completes the 2026-08-13 speed-test fixes:
          fonts 239.8 KB -> ~56 KB, icon-192 89,984 B -> 13,036 B as WebP."
          git push

      - name: Verify the app's own gate passes
        working-directory: productfilter
        run: |
          pip install --quiet -r requirements.txt
          python3 deploycheck.py
